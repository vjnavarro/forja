rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function googleUser() {
      return request.auth != null && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }
    function member() {
      return googleUser()
        && exists(/databases/$(database)/documents/members/$(request.auth.token.email.lower()))
        && get(/databases/$(database)/documents/members/$(request.auth.token.email.lower())).data.enabled == true;
    }
    function owner(uid) { return member() && request.auth.uid == uid; }
    function validDate(value) { return value is string && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'); }
    function validWeight(value) { return value is number && value >= 30 && value <= 350; }
    function shortText(value,max) {return value is string && value.size() <= max;}
    function goal(value) {return value is int && value >= 0 && value <= 14;}
    function avatarLevel(value) { return value is int && value >= 1 && value <= 6; }
    function avatarStages(value) {
      return value is map && value.keys().hasOnly(['start','current','target'])
        && value.keys().hasAll(['start','current','target'])
        && avatarLevel(value.start) && avatarLevel(value.current) && avatarLevel(value.target);
    }
    function profile(uid) {
      let d = request.resource.data;
      return d.keys().hasOnly(['ownerUid','title','initialWeight','targetWeight','startDate','dietStartDate','heightCm','sex','avatar','avatarStages','weeklyGoals','createdAt','updatedAt'])
        && d.keys().hasAll(['ownerUid','title','initialWeight','targetWeight','startDate','dietStartDate','heightCm','sex','avatar','weeklyGoals','createdAt','updatedAt'])
        && d.ownerUid == uid && shortText(d.title,60) && d.title.size() > 0
        && validWeight(d.initialWeight) && validWeight(d.targetWeight) && d.initialWeight != d.targetWeight
        && validDate(d.startDate) && (d.dietStartDate == '' || (validDate(d.dietStartDate) && d.dietStartDate >= d.startDate))
        && (d.heightCm == null || (d.heightCm is number && d.heightCm >= 100 && d.heightCm <= 250))
        && d.sex in ['male','female','unspecified'] && d.avatar in ['male','female','neutral']
        && (!('avatarStages' in d) || avatarStages(d.avatarStages))
        && d.weeklyGoals is map && d.weeklyGoals.keys().hasOnly(['swim','swimMax','strength','core'])
        && goal(d.weeklyGoals.swim) && goal(d.weeklyGoals.swimMax) && d.weeklyGoals.swimMax >= d.weeklyGoals.swim
        && goal(d.weeklyGoals.strength) && goal(d.weeklyGoals.core)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function parentOwner(uid,tid) {return getAfter(/databases/$(database)/documents/users/$(uid)/transformations/$(tid)).data.ownerUid == uid;}
    function sessionParent(uid,tid) {
      let p = getAfter(/databases/$(database)/documents/users/$(uid)/transformations/$(tid)).data;
      return p.ownerUid == uid && p.updatedAt == request.time;
    }
    function weight() {
      let d=request.resource.data;
      return d.keys().hasOnly(['date','kg','status','note','createdAt','updatedAt'])
        && d.keys().hasAll(['date','kg','status','note','createdAt','updatedAt'])
        && validDate(d.date) && validWeight(d.kg) && d.status in ['confirmed','reference','spot']
        && shortText(d.note,500) && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function exercise(value) {
      let name = value.name;
      let sets = value.sets;
      let repetitions = value.repetitions;
      return value is map && value.keys().hasOnly(['name','sets','repetitions'])
        && name is string && name.size() > 0 && name.size() <= 80
        && sets is int && sets >= 0 && sets <= 100
        && repetitions is string && repetitions.size() > 0 && repetitions.size() <= 40;
    }
    function exerciseAt(items,index) { return items.size() <= index || exercise(items[index]); }
    function session() {
      let d=request.resource.data;
      let items=d.exercises;
      return d.keys().hasOnly(['date','type','completed','minutes','distance','exercises','discomfort','notes','origin','createdAt','updatedAt'])
        && d.keys().hasAll(['date','type','completed','minutes','distance','exercises','discomfort','notes','createdAt','updatedAt'])
        && validDate(d.date) && d.type in ['swim','strength','core'] && d.completed is bool
        && (d.minutes == null || (d.minutes is number && d.minutes >= 0 && d.minutes <= 1440))
        && (d.distance == null || (d.distance is number && d.distance >= 0 && d.distance <= 100000))
        && items is list && items.size() <= 6
        && exerciseAt(items,0) && exerciseAt(items,1) && exerciseAt(items,2) && exerciseAt(items,3) && exerciseAt(items,4) && exerciseAt(items,5)
        && d.discomfort in ['not-reported','none','present'] && shortText(d.notes,2000)
        && (!('origin' in d) || sessionOrigin(d.origin))
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function sessionOrigin(o) {
      return o is map && o.keys().hasOnly(['weekStart','templateId','title','focus','level','edited'])
        && validDate(o.weekStart) && shortText(o.templateId,100) && shortText(o.title,80)
        && shortText(o.focus,80) && o.level is int && o.level >= 0 && o.level <= 5 && o.edited is bool;
    }
    function sessionPlanLink(uid,tid,id) {
      let d=request.resource.data;
      return !('origin' in d) || (d.completed == false && d.discomfort == 'not-reported'
        && id == 'week-' + d.date + '-' + d.type
        && originPlanLink(uid,tid,id,d.origin.weekStart));
    }
    function originPlanLink(uid,tid,id,week) {
      let p=getAfter(/databases/$(database)/documents/users/$(uid)/transformations/$(tid)/plans/$(week)).data;
      return p.version==2 && id in p.sessionIds && request.resource.data.date>=p.weekStart && request.resource.data.date<=p.weekEnd;
    }
    function context() {
      let d=request.resource.data;
      return d.keys().hasOnly(['activityNotes','treatmentNotes','lumbarNotes','medicalNotes','sourceNotes','updatedAt'])
        && shortText(d.activityNotes,5000) && shortText(d.treatmentNotes,5000) && shortText(d.lumbarNotes,5000)
        && shortText(d.medicalNotes,5000) && shortText(d.sourceNotes,5000) && d.updatedAt == request.time;
    }
    function linkedSlot(uid,tid,ids,index,start,end) {
      let id = ids[index];
      let s = getAfter(/databases/$(database)/documents/users/$(uid)/transformations/$(tid)/sessions/$(id)).data;
      return id is string && id == 'week-' + s.date
        && s.completed == false && s.discomfort == 'not-reported' && s.minutes == null && s.distance == null
        && s.exercises.size() == 0 && s.date >= start && s.date <= end;
    }
    function plannedSlot(uid,tid,ids,index,start,end) {
      return ids.size() <= index || linkedSlot(uid,tid,ids,index,start,end);
    }
    function weeklyPlan(uid,tid,week) {
      let d = request.resource.data;
      let ids = d.sessionIds;
      return d.keys().hasOnly(['weekStart','weekEnd','source','sessionIds','createdAt'])
        && d.keys().hasAll(['weekStart','weekEnd','source','sessionIds','createdAt'])
        && d.weekStart == week && validDate(d.weekStart) && validDate(d.weekEnd)
        && timestamp.value(d.weekEnd + 'T00:00:00Z') == timestamp.value(d.weekStart + 'T00:00:00Z') + duration.value(6,'d')
        && d.source in ['availability','previous-week','manual'] && d.createdAt == request.time
        && ids is list && ids.size() > 0 && ids.size() <= 7 && ids.toSet().size() == ids.size()
        && plannedSlot(uid,tid,ids,0,d.weekStart,d.weekEnd) && plannedSlot(uid,tid,ids,1,d.weekStart,d.weekEnd)
        && plannedSlot(uid,tid,ids,2,d.weekStart,d.weekEnd) && plannedSlot(uid,tid,ids,3,d.weekStart,d.weekEnd)
        && plannedSlot(uid,tid,ids,4,d.weekStart,d.weekEnd) && plannedSlot(uid,tid,ids,5,d.weekStart,d.weekEnd)
        && plannedSlot(uid,tid,ids,6,d.weekStart,d.weekEnd);
    }
    function weeklyPlanV2(week) {
      let d=request.resource.data;
      let ids=d.sessionIds;
      let joined=ids.join('/');
      return d.keys().hasOnly(['version','weekStart','weekEnd','source','sessionIds','createdAt','updatedAt'])
        && d.keys().hasAll(['version','weekStart','weekEnd','source','sessionIds','createdAt','updatedAt'])
        && d.version == 2 && d.weekStart == week && validDate(d.weekStart) && validDate(d.weekEnd)
        && timestamp.value(d.weekEnd + 'T00:00:00Z') == timestamp.value(d.weekStart + 'T00:00:00Z') + duration.value(6,'d')
        && d.source in ['availability','previous-week','manual','program','review'] && d.createdAt is timestamp && d.updatedAt == request.time
        && ids is list && ids.size() > 0 && ids.size() <= 21 && ids.toSet().size() == ids.size()
        && joined.matches('^week-[0-9]{4}-[0-9]{2}-[0-9]{2}(-(swim|strength|core))?(/week-[0-9]{4}-[0-9]{2}-[0-9]{2}(-(swim|strength|core))?){0,20}$')
        && joined.split('/').size() == ids.size();
    }
    function template() {
      let d=request.resource.data;
      let items=d.exercises;
      return d.keys().hasOnly(['title','focus','level','source','type','minutes','distance','exercises','createdAt','updatedAt'])
        && shortText(d.title,80) && d.title.size()>0 && shortText(d.focus,80) && d.focus.size()>0 && shortText(d.source,1000)
        && d.level is int && d.level >= 1 && d.level <= 5 && d.type in ['swim','strength','core']
        && (d.minutes == null || (d.minutes is number && d.minutes >= 0 && d.minutes <= 1440))
        && (d.distance == null || (d.distance is number && d.distance >= 0 && d.distance <= 100000))
        && items is list && items.size() <= 6 && (d.type == 'swim' || items.size()>0)
        && exerciseAt(items,0) && exerciseAt(items,1) && exerciseAt(items,2) && exerciseAt(items,3) && exerciseAt(items,4) && exerciseAt(items,5)
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function templateIdAt(ids,index) { return ids.size() <= index || (ids[index] is string && ids[index].matches('^[A-Za-z0-9_-]{1,100}$')); }
    function program() {
      let d=request.resource.data;
      let ids=d.templateIds;
      return d.keys().hasOnly(['startWeek','weeks','schedule','templateIds','updatedAt'])
        && validDate(d.startWeek) && d.weeks is int && d.weeks>=1 && d.weeks<=12
        && d.schedule is map && d.schedule.size()>0 && d.schedule.size()<=21 && d.schedule.values().hasOnly([true])
        && d.schedule.keys().hasOnly(['0-swim','0-strength','0-core','1-swim','1-strength','1-core','2-swim','2-strength','2-core','3-swim','3-strength','3-core','4-swim','4-strength','4-core','5-swim','5-strength','5-core','6-swim','6-strength','6-core'])
        && ids is list && ids.size()<=12 && ids.toSet().size()==ids.size()
        && templateIdAt(ids,0) && templateIdAt(ids,1) && templateIdAt(ids,2) && templateIdAt(ids,3) && templateIdAt(ids,4) && templateIdAt(ids,5)
        && templateIdAt(ids,6) && templateIdAt(ids,7) && templateIdAt(ids,8) && templateIdAt(ids,9) && templateIdAt(ids,10) && templateIdAt(ids,11)
        && d.updatedAt == request.time;
    }
    function review(week) {
      let d=request.resource.data;
      return d.keys().hasOnly(['weekStart','wellbeing','discomfort','decision','notes','fingerprint','createdAt','updatedAt'])
        && d.weekStart==week && validDate(week) && d.wellbeing in ['good','mixed','bad'] && d.discomfort in ['none','present','unknown']
        && d.decision in ['maintain','increase','reduce'] && (d.decision != 'increase' || (d.wellbeing == 'good' && d.discomfort == 'none'))
        && shortText(d.notes,2000) && d.fingerprint is string && d.fingerprint.matches('^[0-9a-f]{64}$')
        && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /members/{email} {
      allow get: if googleUser() && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }
    match /users/{uid}/transformations/{tid} {
      allow read: if owner(uid);
      allow create: if owner(uid) && profile(uid) && request.resource.data.createdAt == request.time;
      allow update: if owner(uid) && profile(uid) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if false;
      match /plans/{week} {
        allow read: if owner(uid);
        allow create: if owner(uid) && sessionParent(uid,tid) && (('version' in request.resource.data && weeklyPlanV2(week) && request.resource.data.createdAt == request.time) || (!('version' in request.resource.data) && weeklyPlan(uid,tid,week)));
        allow update: if owner(uid) && sessionParent(uid,tid) && weeklyPlanV2(week)
          && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.sessionIds.hasAll(resource.data.sessionIds);
        allow delete: if owner(uid) && sessionParent(uid,tid);
      }
      match /weights/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && parentOwner(uid,tid) && weight() && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && parentOwner(uid,tid) && weight() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if false;
      }
      match /sessions/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && sessionParent(uid,tid) && session() && sessionPlanLink(uid,tid,id) && request.resource.data.createdAt == request.time;
        allow update: if owner(uid) && sessionParent(uid,tid) && session() && request.resource.data.createdAt == resource.data.createdAt;
        allow delete: if owner(uid) && sessionParent(uid,tid);
      }
      match /private/context {
        allow read: if owner(uid);
        allow create, update: if owner(uid) && parentOwner(uid,tid) && context();
        allow delete: if false;
      }
      match /templates/{id} {
        allow read: if owner(uid);
        allow create: if owner(uid) && sessionParent(uid,tid) && template() && request.resource.data.createdAt==request.time;
        allow update: if owner(uid) && sessionParent(uid,tid) && template() && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if false;
      }
      match /private/program {
        allow read: if owner(uid);
        allow create,update: if owner(uid) && sessionParent(uid,tid) && program();
        allow delete: if false;
      }
      match /reviews/{week} {
        allow read: if owner(uid);
        allow create: if owner(uid) && sessionParent(uid,tid) && review(week) && request.resource.data.createdAt==request.time;
        allow update: if owner(uid) && sessionParent(uid,tid) && review(week) && request.resource.data.createdAt==resource.data.createdAt;
        allow delete: if owner(uid) && sessionParent(uid,tid);
      }
    }
    match /{document=**} { allow read,write: if false; }
  }
}
